# NexusQuant — optional live-alert secrets (copy to .env.live and fill in).
# .env.live is gitignored; this file is committed as a template only.
# Sourced by scripts/daily_morning.sh for the scheduled run (cron has none
# of your shell exports). Use LF line endings (no CRLF).
#
# Discord push alerts (optional):
NEXUS_DISCORD_WEBHOOK=""
#
# Telegram push alerts (optional):
NEXUS_TELEGRAM_BOT_TOKEN=""
NEXUS_TELEGRAM_CHAT_ID=""
