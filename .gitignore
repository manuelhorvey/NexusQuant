# ---- Regenerable market data ----
# Raw MT5 / CSV exports and processed parquet datasets are downloaded or
# regenerated, not versioned. Only the directory skeletons (.gitkeep) are kept.
data/raw/*
!data/raw/.gitkeep
data/archive/
data/processed/
data/external/
# Generated watchlist report dumps (scripts/run_watchlist.py).
data/reports/
# Stage validation outputs (src/analysis/stage*.py, census --write-probs).
data/validation/
# Local vendor fundamentals CSVs (equity Value/Quality factors).
data/fundamentals/

